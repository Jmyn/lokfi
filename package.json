{
  "name": "lokfi",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "test": "turbo test",
    "dev:docs": "pnpm --filter @lokfi/docs dev",
    "build:docs": "pnpm --filter @lokfi/docs build",
    "build:deploy": "pnpm build && cp -r apps/docs/dist apps/web/dist/docs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.19.15",
    "playwright": "^1.59.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "papaparse": "^5.5.3"
  }
}
