{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "docs#build": {
      "dependsOn": [],
      "inputs": [".vitepress/**", "index.md", "guide/**", "reference/**", "public/**"],
      "outputs": ["dist/**"]
    },
    "dev:docs": {
      "cache": false,
      "persistent": true
    }
  }
}
